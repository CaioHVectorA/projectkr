# ==============================================================================
# PROJETO LOOT - Configuração Local
# Copie este arquivo para .env e preencha sua Riot Developer API Key
# ==============================================================================

# Chave de Desenvolvedor da Riot (https://developer.riotgames.com/) - expira a cada 24h
RIOT_API_KEY=RGAPI-SEU-TOKEN-AQUI

# Roteamento padrão (Servidor BR1 -> plataforma br1, routing regional americas)
RIOT_PLATFORM=br1
RIOT_REGIONAL=americas

# Porta do servidor único (API + Frontend)
PORT=3000

# Configuração do CLI local do Antigravity (agy)
# No Windows, se "agy" não estiver no PATH, informe o caminho completo (ex: C:\Users\Voce\...\agy.cmd)
AGY_BIN=agy

# Modo de envio do prompt ao agy:
#   arg   -> executa: agy -p "<prompt>" (padrão; payload comprimido < 6KB para limite do Windows)
#   stdin -> executa: agy -p - e envia o prompt via stdin (evita qualquer limite de linha de comando)
AGY_MODE=arg

# Timeout máximo do processo agy em milissegundos (padrão: 90000 = 90s)
AGY_TIMEOUT_MS=90000

# Lente 2 (Live Coach — Read-Only)
LIVE_CLIENT_URL=https://127.0.0.1:2999
LIVE_POLL_INTERVAL_MS=12000
LIVE_COACH_COOLDOWN_MS=60000
